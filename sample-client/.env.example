# TheSafeZone IDP Configuration
# Copy this file to .env and fill in your values

# Cognito User Pool Client ID (use SampleClientId from CDK output)
VITE_COGNITO_CLIENT_ID=your-client-id

# Cognito Domain (e.g., thesafezone-auth.auth.eu-central-1.amazoncognito.com)
VITE_COGNITO_DOMAIN=your-domain.auth.region.amazoncognito.com

# This app's callback URL (must be registered in Cognito)
VITE_REDIRECT_URI=http://localhost:3001/callback

# Client secret (optional). When set, token exchange goes through a backend
# proxy so the secret is never exposed to the browser.
# Leave empty or omit for public client (PKCE-only) flow.
# VITE_CLIENT_SECRET=your-client-secret

# Login UI URL for profile editing (default Vite port is 5173)
VITE_LOGIN_UI_URL=http://localhost:5173
